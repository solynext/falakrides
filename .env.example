# Set to your verified public origin before a production build.
# Leave unset for previews (robots disallows crawling; sitemap is empty).
SITE_URL=

# Neon PostgreSQL and admin authentication.
DATABASE_URL=
# Neon pooled URL above; optional direct URL for Prisma migrations below.
DIRECT_URL=
# Local development. On Vercel production, set to https://falakride.vercel.app
# (or your custom domain). Vercel system URLs are also trusted automatically.
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated additional trusted origins (include scheme and port).
AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set only when a trusted reverse proxy overwrites incoming IP headers.
TRUST_PROXY=false

# Admin password reset via Gmail SMTP (server only).
# Enable Google 2-Step Verification and create a Gmail App Password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Optional real outbound email delivery.
# EMAIL_FROM must be a sender on a domain verified with Resend.
# Never expose these as NEXT_PUBLIC variables.
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Optional hosted card checkout and verified card refunds.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary server credentials. Never use NEXT_PUBLIC_ for the API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=falakrides
